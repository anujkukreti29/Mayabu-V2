VITE_API_BASE_URL=http://127.0.0.1:8000
# SSR / Node always calls the absolute backend. Defaults to VITE_API_BASE_URL.
VITE_API_SERVER_URL=http://127.0.0.1:8000
# development default is same-origin (Vite proxies /api). Use absolute for e2e/mock.
# VITE_API_BROWSER_MODE=same-origin
VITE_SITE_URL=http://localhost:5173
# Public canonical host (production must be https://your-domain). See docs/SEO_V2.md
VITE_CANONICAL_HOST=http://localhost:5173
# development | staging | production | test
VITE_APP_ENV=development
VITE_RENDER_MODE=ssr
VITE_ENABLE_AUTH=true
VITE_ENABLE_TRACKER=false
VITE_ENABLE_ASSISTANT=false
VITE_ENABLE_ADMIN=false
VITE_ENABLE_DEALS=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_COOKIE_BANNER=false

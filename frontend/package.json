{
  "name": "mayabu-frontend",
  "version": "5.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:client": "react-router build && node scripts/verify-client-build.mjs",
    "build:server": "react-router build && node scripts/verify-server-build.mjs",
    "prerender": "react-router build && node scripts/verify-prerender.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "preview": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --maxWorkers=4",
    "test:coverage": "vitest run --coverage --maxWorkers=4",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seo:verify": "react-router build && node scripts/verify-seo.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build && node scripts/verify-prerender.mjs && node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@hookform/resolvers": "4.1.0",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@react-router/node": "7.18.1",
    "@react-router/serve": "7.18.1",
    "@tanstack/react-query": "5.66.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.1.21",
    "lucide-react": "0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-router": "7.18.1",
    "tailwind-merge": "3.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@react-router/dev": "7.18.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "15.15.0",
    "jsdom": "26.0.0",
    "postcss": "8.5.19",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.63.0",
    "vite": "6.4.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
}

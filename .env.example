# Mayabu v5.4 local environment. Copy to .env and never commit real secrets.
DATABASE_URL=postgresql://mayabu:mayabu_dev_password@127.0.0.1:5433/mayabu
REDIS_URL=redis://127.0.0.1:6379/0
MAYABU_DB_SCHEMA=public
MAYABU_ENV=development

# API
MAYABU_API_HOST=127.0.0.1
MAYABU_API_PORT=8000
MAYABU_API_WORKERS=1
# Per API process. Keep aligned with the per-process DB pool size.
MAYABU_API_THREADPOOL_TOKENS=40
MAYABU_ADMIN_TOKEN=change-this-before-production
MAYABU_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
MAYABU_MAX_QUERY_LENGTH=180
MAYABU_PUBLIC_RATE_LIMIT_PER_MINUTE=60
# Enable only behind a trusted proxy that replaces forwarding headers.
MAYABU_TRUST_PROXY_HEADERS=false

# Cache
MAYABU_ENABLE_REDIS_CACHE=true
MAYABU_ENABLE_REDIS_RATE_LIMIT=true
MAYABU_SEARCH_CACHE_TTL_SECONDS=600
MAYABU_PRODUCT_CACHE_TTL_SECONDS=900
MAYABU_PRICE_HISTORY_CACHE_TTL_SECONDS=1800

# PostgreSQL pool and query guardrails
MAYABU_DB_POOL_MIN_SIZE=1
MAYABU_DB_POOL_MAX_SIZE=10
MAYABU_DB_POOL_TIMEOUT_SECONDS=10
MAYABU_DB_POOL_MAX_WAITING=30
MAYABU_DB_POOL_MAX_LIFETIME_SECONDS=1800
MAYABU_DB_POOL_MAX_IDLE_SECONDS=300
MAYABU_DB_CONNECT_TIMEOUT_SECONDS=8
MAYABU_DB_STATEMENT_TIMEOUT_MS=15000

# Workers and scraping
# Optional. Defaults to a hostname-derived ID so scaled replicas remain unique.
# MAYABU_WORKER_ID=worker-node-a
MAYABU_WORKER_CONCURRENCY=2
MAYABU_WORKER_POLL_SECONDS=5
MAYABU_WORKER_SHUTDOWN_GRACE_SECONDS=30
MAYABU_WORKER_TASK_LEASE_MINUTES=20
MAYABU_WORKER_LEASE_REFRESH_SECONDS=120
MAYABU_SCRAPER_PLATFORM_CONCURRENCY=2
MAYABU_SCRAPER_HEADLESS=true
MAYABU_SCRAPER_DEBUG=false
# Shared Redis lease used by discovery, refresh, direct-ingest, and verification workers.
MAYABU_SCRAPER_DISTRIBUTED_SLOT_TTL_SECONDS=180
MAYABU_SCRAPER_DISTRIBUTED_SLOT_WAIT_SECONDS=5
MAYABU_SCRAPER_NAVIGATION_ATTEMPTS=3
MAYABU_SCRAPER_TIMEOUT_MS=50000
MAYABU_SCRAPER_RETRY_BASE_SECONDS=2
MAYABU_SCRAPER_MAX_PAGES=50
MAYABU_SCRAPER_MAX_PRODUCTS=1000
MAYABU_HEADLESS=true
MAYABU_CROMA_HEADLESS=true
MAYABU_RAW_ARTIFACT_DIR=artifacts/raw
MAYABU_DEBUG_ARTIFACT_DIR=artifacts/debug

# Circuit breaker
MAYABU_CIRCUIT_FAILURE_THRESHOLD=5
MAYABU_CIRCUIT_COOLDOWN_SECONDS=900

# Retention and incremental indexing
MAYABU_RAW_ITEM_RETENTION_DAYS=30
MAYABU_RAW_PRICE_RETENTION_DAYS=180
MAYABU_COMPLETED_TASK_RETENTION_DAYS=30
MAYABU_LIVE_VERIFICATION_EVENT_RETENTION_DAYS=30
MAYABU_SEARCH_DOCUMENT_BATCH_SIZE=250
MAYABU_SEARCH_FETCH_LIMIT=300

# CLI safety caps
MAYABU_CLI_MAX_SAFE_PAGES=50
MAYABU_CLI_MAX_SAFE_PRODUCTS=1000

# Optional proxy for production scraper workers only.
# MAYABU_SCRAPER_PROXY=http://user:pass@host:port

# Docker Compose database password interpolation (change outside local development).
MAYABU_POSTGRES_PASSWORD=mayabu_dev_password

# Mayabu v5.2 live price verification
# A click is explicit permission to verify a known store URL. User IPs are never used as proxies.
MAYABU_LIVE_VERIFY_FRESH_SECONDS=180
MAYABU_LIVE_VERIFY_COOLDOWN_SECONDS=300
MAYABU_LIVE_VERIFY_FAILURE_COOLDOWN_SECONDS=900
MAYABU_LIVE_VERIFY_MAX_FAILURE_COOLDOWN_SECONDS=21600
MAYABU_LIVE_VERIFY_QUEUE_MAX_ACTIVE=2000
MAYABU_LIVE_VERIFY_PER_USER_PER_MINUTE=6
# Smooths many-different-product bursts before they can exhaust the DB pool.
MAYABU_LIVE_VERIFY_GLOBAL_PER_MINUTE=300
MAYABU_LIVE_VERIFY_MAX_OFFERS_PER_REQUEST=4
MAYABU_LIVE_VERIFY_PRIORITY=5
MAYABU_LIVE_VERIFY_MAX_ATTEMPTS=2
MAYABU_LIVE_VERIFY_ESTIMATED_SECONDS=15
MAYABU_LIVE_VERIFY_BUSY_RETRY_SECONDS=30
MAYABU_LIVE_VERIFY_LIGHTWEIGHT_TIMEOUT_SECONDS=8
# Deprecated compatibility aliases. Use MAYABU_SCRAPER_DISTRIBUTED_SLOT_* for new deployments.
MAYABU_LIVE_VERIFY_DISTRIBUTED_SLOT_TTL_SECONDS=180
MAYABU_LIVE_VERIFY_DISTRIBUTED_SLOT_WAIT_SECONDS=5

# React + Vite frontend public configuration
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SITE_URL=http://localhost:5173
VITE_APP_ENV=development
VITE_RENDER_MODE=ssr
VITE_CANONICAL_HOST=http://localhost:5173
VITE_ENABLE_AUTH=false
VITE_ENABLE_TRACKER=false
VITE_ENABLE_ASSISTANT=false
VITE_ENABLE_ADMIN=false
VITE_ENABLE_DEALS=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_COOKIE_BANNER=false

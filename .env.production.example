# Production environment template — copy to a secret store / runtime env.
# Do NOT commit real credentials. Do NOT put secrets in VITE_* variables.

MAYABU_ENV=production

# Public HTTPS
MAYABU_AUTH_PUBLIC_BASE_URL=https://mayabu.example
MAYABU_CORS_ORIGINS=https://mayabu.example

DATABASE_URL=postgresql://mayabu_app:CHANGE_ME@db.internal:5432/mayabu?sslmode=require
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0

MAYABU_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM
MAYABU_TRUST_PROXY_HEADERS=true
MAYABU_AUTH_COOKIE_SECURE=true
MAYABU_AUTH_COOKIE_SAMESITE=lax
MAYABU_AUTH_DEV_INBOX=0

MAYABU_AUTH_EMAIL_PROVIDER=resend
MAYABU_AUTH_EMAIL_FROM=Mayabu <noreply@mayabu.example>
MAYABU_AUTH_EMAIL_API_KEY=CHANGE_ME
MAYABU_AUTH_EMAIL_TIMEOUT_SECONDS=8

MAYABU_API_HOST=0.0.0.0
MAYABU_API_PORT=8000
MAYABU_API_WORKERS=2
MAYABU_DB_POOL_MIN_SIZE=1
MAYABU_DB_POOL_MAX_SIZE=8
MAYABU_API_THREADPOOL_TOKENS=40
MAYABU_HEALTH_REQUIRE_ADMIN=true

MAYABU_ENABLE_REDIS_CACHE=true
MAYABU_ENABLE_REDIS_RATE_LIMIT=true

MAYABU_RELEASE_VERSION=1.0.0
MAYABU_GIT_SHA=

# Connection budget reminder:
# api_workers * db_pool_max_size + worker_processes * worker_pool + admin/migrations
# must stay under managed PostgreSQL max_connections.

# Frontend build-time PUBLIC config only:
# VITE_APP_ENV=production
# VITE_SITE_URL=https://mayabu.example
# VITE_CANONICAL_HOST=https://mayabu.example
# VITE_API_BROWSER_MODE=same-origin
# VITE_API_SERVER_URL=http://mayabu-api:8000

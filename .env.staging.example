# Staging environment template — copy to .env.staging (never commit secrets).
# Real staging should use HTTPS public hosts. For local insecure staging stacks set:
# MAYABU_ALLOW_INSECURE_LOCAL=1

MAYABU_ENV=staging
MAYABU_ALLOW_INSECURE_LOCAL=0

# Public HTTPS hosts (replace with your staging domain)
MAYABU_AUTH_PUBLIC_BASE_URL=https://staging.example.com
MAYABU_CORS_ORIGINS=https://staging.example.com

DATABASE_URL=postgresql://mayabu_app:CHANGE_ME@db.internal:5432/mayabu_staging?sslmode=require
REDIS_URL=rediss://:CHANGE_ME@redis.internal:6379/0

MAYABU_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM
MAYABU_TRUST_PROXY_HEADERS=true
MAYABU_AUTH_COOKIE_SECURE=true
MAYABU_AUTH_COOKIE_SAMESITE=lax

# Email: console only with MAYABU_ALLOW_INSECURE_LOCAL=1; prefer Resend on real staging
MAYABU_AUTH_EMAIL_PROVIDER=resend
MAYABU_AUTH_EMAIL_FROM=Mayabu Staging <noreply@staging.example.com>
MAYABU_AUTH_EMAIL_API_KEY=CHANGE_ME
MAYABU_AUTH_DEV_INBOX=0

MAYABU_API_HOST=0.0.0.0
MAYABU_API_PORT=8000
MAYABU_API_WORKERS=2
MAYABU_DB_POOL_MAX_SIZE=8
MAYABU_API_THREADPOOL_TOKENS=40
MAYABU_HEALTH_REQUIRE_ADMIN=true

# Enable only when workers are supervised and retailer coverage is production-ready
MAYABU_SCHEDULER_ENABLED=false
MAYABU_SCHEDULER_TICK_SECONDS=60
MAYABU_SCHEDULER_LEASE_SECONDS=90

MAYABU_WORKER_CONCURRENCY=2
MAYABU_SCRAPER_PLATFORM_CONCURRENCY=2
# Non-root container Chromium typically requires no-sandbox; prefer seccomp/AppArmor at host.
MAYABU_SCRAPER_CHROMIUM_NO_SANDBOX=1
MAYABU_SCRAPER_CHROMIUM_DISABLE_DEV_SHM=1
MAYABU_SCRAPER_DISTRIBUTED_SLOT_TTL_SECONDS=180
MAYABU_SCRAPER_DISTRIBUTED_SLOT_WAIT_SECONDS=5
# Isolate Redis keys from other environments (defaults to MAYABU_ENV when unset).
MAYABU_REDIS_KEY_PREFIX=staging

# Alert delivery — required for staging GO. Leave unset until webhook exists.
# MAYABU_ALERT_WEBHOOK_URL=https://hooks.example/services/...

MAYABU_RELEASE_VERSION=staging
MAYABU_GIT_SHA=

# Frontend build-time (never put email/DB secrets in VITE_*)
# VITE_APP_ENV=staging
# VITE_SITE_URL=https://staging.example.com
# VITE_CANONICAL_HOST=https://staging.example.com
# VITE_API_BROWSER_MODE=same-origin
# VITE_API_SERVER_URL=http://api.internal:8000
